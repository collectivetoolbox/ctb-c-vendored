+    fn apply_filter_specs_to_lzma(
+        options: &mut lzma_rust2::LzmaOptions,
+        filter_specs: Vec<PyObjectRef>,
+        vm: &VirtualMachine,
+    ) -> PyResult<()> {
+        if filter_specs.len() != 1 {
+            return Err(new_lzma_error(
+                "Only one filter can be specified for LZMA format",
