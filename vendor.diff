+    impl DecompressEngine {
+        fn process(
+            &mut self,
+            input: &[u8],
+            output: &mut [u8],
+            check_out: &mut i32,
+        ) -> Result<StreamResult, String> {
+            match self {
+                Self::Xz(s) => {
+                    let res = s
+                        .process(input, output, Action::Run)
