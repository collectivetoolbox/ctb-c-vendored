+
+fn read_wayland_clipboard() -> Option<String> {
+    use std::process::Command;
+    let output = Command::new("wl-paste")
+        .arg("--no-newline")
+        .output()
+        .ok()?;
+    if output.status.success() {
+        String::from_utf8(output.stdout).ok()
+    } else {
+        None
+    }
+}
+
+fn write_wayland_clipboard(text: &str) {
+    use std::process::{Command, Stdio};
+    use std::io::Write;
+    if let Ok(mut child) = Command::new("wl-copy")
+        .stdin(Stdio::piped())
+        .spawn()
+    {
+        if let Some(mut stdin) = child.stdin.take() {
+            let _ = stdin.write_all(text.as_bytes());
+        }
+        let _ = child.wait();
+    }
+}
+
+fn read_wayland_primary_clipboard() -> Option<String> {
+    use std::process::Command;
+    let output = Command::new("wl-paste")
+        .arg("--primary")
+        .arg("--no-newline")
+        .output()
+        .ok()?;
+    if output.status.success() {
+        String::from_utf8(output.stdout).ok()
+    } else {
+        None
+    }
+}
+
+fn write_wayland_primary_clipboard(text: &str) {
+    use std::process::{Command, Stdio};
+    use std::io::Write;
+    if let Ok(mut child) = Command::new("wl-copy")
+        .arg("--primary")
+        .stdin(Stdio::piped())
+        .spawn()
+    {
+        if let Some(mut stdin) = child.stdin.take() {
+            let _ = stdin.write_all(text.as_bytes());
+        }
+        let _ = child.wait();
+    }
+}
+
+fn primary_selection_text(info: &egui::WidgetInfo) -> Option<String> {
+    let text = info.current_text_value.as_ref()?;
+    let selection = info.text_selection.as_ref()?;
+    let start = (*selection.start()).min(*selection.end());
+    let end = (*selection.start()).max(*selection.end());
+    if start == end {
+        return None;
+    }
+
+    Some(text.chars().skip(start).take(end - start).collect())
+}
